# ─── POSTGRESQL ───────────────────────────────────────────────
POSTGRES_USER=esoter_admin
POSTGRES_PASSWORD=

# ─── MYSQL (Cartas y significados esotéricos) ─────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=esoter_cards
MYSQL_USER=cards_user
MYSQL_PASSWORD=

# ─── QDRANT ───────────────────────────────────────────────────
QDRANT_API_KEY=

# ─── REDIS ────────────────────────────────────────────────────
# WARNING: Do not use shell special chars (&, ^, $, !, |) — they break docker-compose
# even with JSON array command. Use only alphanumeric + underscore + hyphen.
REDIS_PASSWORD=

# ─── N8N ──────────────────────────────────────────────────────
DOMAIN_N8N=n8n.ether.care
N8N_USER=admin
N8N_PASSWORD=
N8N_ENCRYPTION_KEY=

# ─── LLMs ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GOOGLE_API_KEY=

# ─── STRIPE ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── META ─────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=

# ─── TIKTOK ───────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── DOMINIOS ─────────────────────────────────────────────────
DOMAIN_N8N=n8n.ether.care
DOMAIN_API=api.ether.care
DOMAIN_ADMIN=admin.ether.care
DOMAIN_SYSTEM=system.ether.care

# ─── OTHER ────────────────────────────────────────────────────
ADMIN_API_KEY=
META_WHATSAPP_PHONE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
